{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-ads-agent.local/schemas/strategy-brief.schema.json",
  "title": "Evidence-Led Campaign Strategy Brief",
  "type": "object",
  "additionalProperties": true,
  "required": ["mode", "dataAccess", "observations", "inferences", "evidence", "missingData", "recommendedAction", "doNotChangeYet", "campaignPlan"],
  "properties": {
    "mode": { "const": "STRATEGIST" },
    "dataAccess": { "const": "USER_PROVIDED" },
    "observations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "inferences": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 1 },
    "missingData": { "type": "array", "items": { "type": "string" } },
    "recommendedAction": { "type": "string", "minLength": 1 },
    "doNotChangeYet": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "campaignPlan": {
      "type": "object",
      "required": ["objective", "optimizationEvent", "budget", "market", "offer", "landingDestination", "audienceHypothesis", "creativeHypothesis"],
      "properties": {
        "objective": { "type": "string" },
        "optimizationEvent": { "type": "string" },
        "budget": { "type": "object" },
        "market": { "type": "string" },
        "offer": { "type": "string" },
        "landingDestination": { "type": "string" },
        "audienceHypothesis": { "type": "string" },
        "creativeHypothesis": { "type": "string" }
      }
    }
  }
}
