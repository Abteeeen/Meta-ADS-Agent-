{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-ads-agent.local/schemas/workspace-manifest.schema.json",
  "title": "Company Workspace Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceSlug", "dataClassification", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workspaceSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dataClassification": { "enum": ["SANITIZED", "CONFIDENTIAL", "RESTRICTED"] },
    "status": { "enum": ["DISCOVERY", "READY_TO_PLAN", "ACTIVE", "PAUSED", "ARCHIVED"] },
    "createdAt": { "type": "string", "format": "date" },
    "owner": { "type": "string", "minLength": 1 },
    "repositoryPolicy": { "enum": ["LOCAL_ONLY", "PRIVATE_REPOSITORY", "SANITIZED_PUBLIC"] }
  }
}
