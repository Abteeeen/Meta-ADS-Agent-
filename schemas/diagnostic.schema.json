{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-ads-agent.local/schemas/diagnostic.schema.json",
  "title": "Performance Diagnostic",
  "type": "object",
  "additionalProperties": true,
  "required": ["mode", "metrics", "baselineMetrics", "experimentPlan", "evidence", "inferences"],
  "properties": {
    "mode": { "const": "ANALYST" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "baselineMetrics": { "$ref": "#/$defs/metrics" },
    "experimentPlan": { "type": "object", "required": ["hypothesis", "primaryVariable", "guardrails", "decisionRule"] },
    "evidence": { "type": "array", "minItems": 1 },
    "inferences": { "type": "array", "minItems": 1 }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": ["spend", "impressions", "clicks", "conversions", "cpm", "ctr", "cpc", "conversionRate", "cpa"]
    }
  }
}
