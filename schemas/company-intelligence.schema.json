{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-ads-agent.local/schemas/company-intelligence.schema.json",
  "title": "Company Intelligence Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "companyName", "overallStatus", "specialistJobs", "autoDiscoveryGaps", "questionQueue", "integrationRequests", "strategySynthesis"],
  "properties": {
    "mode": { "const": "COMPANY_INTELLIGENCE" },
    "companyName": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": ["NEEDS_EVIDENCE", "READY_FOR_SYNTHESIS"] },
    "specialistJobs": { "type": "array", "minItems": 6 },
    "autoDiscoveryGaps": { "type": "array" },
    "questionQueue": { "type": "array" },
    "integrationRequests": { "type": "array" },
    "strategySynthesis": { "type": "object", "required": ["status", "rule"] }
  }
}
