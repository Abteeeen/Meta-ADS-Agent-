{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-ads-agent.local/schemas/claim.schema.json",
  "title": "Reviewed Knowledge Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "sourceId", "sourceLocation", "classification", "confidence", "reviewedAt", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{2,99}$" },
    "statement": { "type": "string", "minLength": 10 },
    "sourceId": { "type": "string", "minLength": 3 },
    "sourceLocation": { "type": "string", "description": "Timecode, section, page, API endpoint, or other stable location." },
    "classification": { "enum": ["PLATFORM_FACT", "COURSE_GUIDANCE", "AGENCY_RULE", "HYPOTHESIS", "CASE_STUDY", "OUTDATED_OR_UNVERIFIED"] },
    "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "conditions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "conflictsWith": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "reviewedAt": { "type": "string", "format": "date" },
    "status": { "enum": ["ACTIVE", "NEEDS_REVIEW", "OUTDATED", "REJECTED"] }
  }
}
